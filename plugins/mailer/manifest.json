{
  "schemaVersion": 1,
  "id": "official.mailer",
  "category": "identity",
  "name": "邮件服务",
  "description": "发送注册、登录及安全验证邮件。",
  "codeReload": "restart",
  "version": "0.1.0-alpha.15",
  "host": ">=0.1.0-alpha.1 <0.2.0-0",
  "runtime": {
    "kind": "native",
    "entry": "dist/index.js"
  },
  "provides": ["mail.send@1", "mail.options@1"],
  "requires": [],
  "optionalRequires": ["site.branding@1", "users.lookup@1"],
  "permissions": ["api.register", "secrets.read"],
  "configReload": "snapshot",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "secretRefs": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^env:[A-Z][A-Z0-9_]*$"
        }
      },
      "host": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253
      },
      "port": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "from": {
        "type": "string",
        "minLength": 1,
        "maxLength": 254
      },
      "secure": {
        "type": "boolean"
      },
      "tlsServerName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.-]*$"
      },
      "allowInsecure": {
        "type": "boolean"
      },
      "user": {
        "type": "string",
        "maxLength": 320
      },
      "passwordRef": {
        "type": "string",
        "pattern": "^env:[A-Z][A-Z0-9_]*$"
      }
    }
  },
  "ui": {
    "entry": "dist/ui.js",
    "title": "邮件发件",
    "path": "/mailer",
    "public": false,
    "group": "verification-services",
    "order": 20
  }
}
