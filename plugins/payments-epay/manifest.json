{
  "schemaVersion": 1,
  "id": "official.payments-epay",
  "category": "commerce",
  "name": "易支付",
  "description": "对接易支付 V1/V2、MD5/RSA 签名。",
  "codeReload": "restart",
  "version": "0.1.0-alpha.4",
  "host": ">=0.1.0-alpha.1 <0.2.0-0",
  "runtime": {
    "kind": "native",
    "entry": "dist/index.js"
  },
  "provides": [
    "payments.epay@1"
  ],
  "requires": [
    "commerce.payment@1",
    "http.transport@1"
  ],
  "optionalRequires": [],
  "permissions": [
    "api.register",
    "secrets.read"
  ],
  "configReload": "snapshot",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "version": {
        "enum": [
          "v1",
          "v2"
        ]
      },
      "algorithm": {
        "enum": [
          "MD5",
          "RSA"
        ]
      },
      "pid": {
        "type": "string"
      },
      "baseUrl": {
        "type": "string"
      },
      "publicUrl": {
        "type": "string"
      },
      "paymentType": {
        "enum": [
          "alipay",
          "wxpay",
          "qqpay"
        ]
      },
      "clientIp": {
        "type": "string"
      },
      "keyRef": {
        "type": "string",
        "pattern": "^env:[A-Z][A-Z0-9_]*$"
      },
      "privateKeyRef": {
        "type": "string",
        "pattern": "^env:[A-Z][A-Z0-9_]*$"
      },
      "platformPublicKeyRef": {
        "type": "string",
        "pattern": "^env:[A-Z][A-Z0-9_]*$"
      },
      "secretRefs": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^env:[A-Z][A-Z0-9_]*$"
        },
        "uniqueItems": true
      }
    }
  },
  "ui": {
    "title": "易支付",
    "entry": "dist/ui.js",
    "path": "/payments-epay",
    "public": false,
    "group": "payment-adapters",
    "order": 20
  }
}
