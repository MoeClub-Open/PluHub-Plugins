{
  "schemaVersion": 1,
  "id": "official.payments-epay",
  "category": "commerce",
  "name": "易支付",
  "description": "对接易支付 V1/V2、MD5/RSA 签名。",
  "codeReload": "restart",
  "version": "0.1.0-alpha.16",
  "host": ">=0.1.0-alpha.16 <0.2.0-0",
  "runtime": {
    "kind": "native",
    "entry": "dist/index.js"
  },
  "provides": ["payments.provider@1"],
  "requires": ["commerce.payment@1", "http.transport@1"],
  "optionalRequires": ["auth.admin@1"],
  "permissions": ["api.register", "secrets.read"],
  "configReload": "snapshot",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "nextMethodId": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "version": {
        "enum": ["v1", "v2"]
      },
      "algorithm": {
        "enum": ["MD5", "RSA"]
      },
      "pid": {
        "type": "string"
      },
      "baseUrl": {
        "type": "string"
      },
      "publicUrl": {
        "type": "string"
      },
      "paymentType": {
        "enum": ["alipay", "wxpay", "qqpay"]
      },
      "clientIp": {
        "type": "string"
      },
      "keyRef": {
        "type": "string",
        "pattern": "^(?:(?:env:[A-Z][A-Z0-9_]*|secret:[A-Za-z0-9][A-Za-z0-9_.-]*)|local:[a-f0-9-]{36})$"
      },
      "privateKeyRef": {
        "type": "string",
        "pattern": "^(?:(?:env:[A-Z][A-Z0-9_]*|secret:[A-Za-z0-9][A-Za-z0-9_.-]*)|local:[a-f0-9-]{36})$"
      },
      "platformPublicKeyRef": {
        "type": "string",
        "pattern": "^(?:(?:env:[A-Z][A-Z0-9_]*|secret:[A-Za-z0-9][A-Za-z0-9_.-]*)|local:[a-f0-9-]{36})$"
      },
      "secretRefs": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(?:env:[A-Z][A-Z0-9_]*|secret:[A-Za-z0-9][A-Za-z0-9_.-]*)$"
        },
        "uniqueItems": true
      },
      "methods": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "paymentType"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "version": {
              "enum": ["v1", "v2"]
            },
            "algorithm": {
              "enum": ["MD5", "RSA"]
            },
            "pid": {
              "type": "string"
            },
            "baseUrl": {
              "type": "string"
            },
            "publicUrl": {
              "type": "string"
            },
            "paymentType": {
              "enum": ["alipay", "wxpay", "qqpay"]
            },
            "clientIp": {
              "type": "string"
            },
            "keyRef": {
              "type": "string",
              "pattern": "^(?:(?:env:[A-Z][A-Z0-9_]*|secret:[A-Za-z0-9][A-Za-z0-9_.-]*)|local:[a-f0-9-]{36})$"
            },
            "privateKeyRef": {
              "type": "string",
              "pattern": "^(?:(?:env:[A-Z][A-Z0-9_]*|secret:[A-Za-z0-9][A-Za-z0-9_.-]*)|local:[a-f0-9-]{36})$"
            },
            "platformPublicKeyRef": {
              "type": "string",
              "pattern": "^(?:(?:env:[A-Z][A-Z0-9_]*|secret:[A-Za-z0-9][A-Za-z0-9_.-]*)|local:[a-f0-9-]{36})$"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "name": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      }
    }
  },
  "ui": {
    "title": "易支付",
    "entry": "dist/ui.js",
    "path": "/payments-epay",
    "public": false,
    "group": "payment-adapters",
    "order": 20
  }
}
