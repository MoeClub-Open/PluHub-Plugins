{
  "schemaVersion": 1,
  "id": "official.upstream-openai-chat",
  "category": "upstream",
  "name": "OpenAI Chat Completions 上游",
  "description": "调用 OpenAI Chat Completions 兼容服务并解析结果。",
  "codeReload": "parallel",
  "version": "0.1.0-alpha.15",
  "host": ">=0.1.0-alpha.1 <0.2.0-0",
  "runtime": {
    "kind": "native",
    "entry": "dist/index.js"
  },
  "provides": ["ai.upstream.openai-chat@1", "ai.upstream-models.openai-chat@1"],
  "requires": ["http.transport@1"],
  "permissions": ["secrets.read"],
  "configReload": "snapshot",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "secretRefs": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^env:[A-Z][A-Z0-9_]*$"
        }
      }
    }
  },
  "optionalRequires": ["credentials.resolve@1"]
}
