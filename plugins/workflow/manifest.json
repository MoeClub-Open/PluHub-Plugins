{
  "schemaVersion": 1,
  "id": "official.workflow",
  "category": "routing",
  "name": "旧版流程兼容",
  "description": "为旧配置提供 ai.workflow 能力；新渠道直接使用渠道内的流程图。",
  "codeReload": "restart",
  "version": "0.1.0-alpha.4",
  "host": ">=0.1.0-alpha.1 <0.2.0-0",
  "runtime": {
    "kind": "native",
    "entry": "dist/index.js"
  },
  "provides": [
    "ai.workflow@1"
  ],
  "requires": [],
  "permissions": [
    "api.register"
  ],
  "configReload": "snapshot",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "flows": {
        "type": "object",
        "maxProperties": 128,
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry",
            "nodes"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 128
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "type",
                      "next"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "type": {
                        "const": "start"
                      },
                      "next": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "type",
                      "test",
                      "yes",
                      "no"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "type": {
                        "const": "condition"
                      },
                      "test": {
                        "enum": [
                          "hasTools",
                          "stream",
                          "textLengthAbove",
                          "protocol"
                        ]
                      },
                      "value": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000000
                      },
                      "yes": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "no": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "protocol": {
                        "enum": [
                          "openai-chat",
                          "openai-responses",
                          "anthropic",
                          "gemini"
                        ]
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "test": {
                              "const": "protocol"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "protocol"
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "type",
                      "next",
                      "text"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "type": {
                        "const": "prompt"
                      },
                      "next": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "type",
                      "next",
                      "effort"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "type": {
                        "const": "reasoning"
                      },
                      "next": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "effort": {
                        "enum": [
                          "none",
                          "minimal",
                          "low",
                          "medium",
                          "high",
                          "xhigh",
                          "max"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "type",
                      "next",
                      "limit"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "type": {
                        "const": "maxTokens"
                      },
                      "next": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "limit": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "type",
                      "next",
                      "tokenizer"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "type": {
                        "const": "tps"
                      },
                      "next": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "rate": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      },
                      "tokenizer": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.-]{1,128}$"
                      },
                      "aggregateRate": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "inheritDefault": {
                        "type": "boolean"
                      }
                    },
                    "anyOf": [
                      {
                        "required": [
                          "rate"
                        ]
                      },
                      {
                        "required": [
                          "aggregateRate"
                        ]
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "type",
                      "target",
                      "mode"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "type": {
                        "const": "upstream"
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "mode": {
                        "enum": [
                          "implicit",
                          "explicit"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "type"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "type": {
                        "const": "provider"
                      },
                      "upstream": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "protocol"
                        ],
                        "properties": {
                          "protocol": {
                            "enum": [
                              "openai-chat",
                              "openai-responses",
                              "anthropic",
                              "gemini",
                              "codex",
                              "claude-subscription",
                              "antigravity"
                            ]
                          },
                          "baseUrl": {
                            "type": "string",
                            "pattern": "^https?://"
                          },
                          "keyRef": {
                            "type": "string",
                            "pattern": "^env:[A-Z][A-Z0-9_]*$"
                          },
                          "accountId": {
                            "type": "string",
                            "maxLength": 512
                          },
                          "projectId": {
                            "type": "string",
                            "maxLength": 512
                          },
                          "authMode": {
                            "enum": [
                              "siwc",
                              "cli"
                            ]
                          },
                          "subscriptionAccountIds": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 100,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          }
                        },
                        "allOf": [
                          {
                            "anyOf": [
                              {
                                "required": [
                                  "baseUrl",
                                  "keyRef"
                                ]
                              },
                              {
                                "required": [
                                  "subscriptionAccountIds"
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "type",
                      "profile"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "type": {
                        "const": "routing"
                      },
                      "profile": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "type",
                      "next",
                      "allow",
                      "conversion"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "type": {
                        "const": "protocol"
                      },
                      "next": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "allow": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 4,
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            "openai-chat",
                            "openai-responses",
                            "anthropic",
                            "gemini"
                          ]
                        }
                      },
                      "conversion": {
                        "enum": [
                          "auto",
                          "disabled"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "type",
                      "next",
                      "rule"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "type": {
                        "const": "rateLimit"
                      },
                      "next": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "rule": {
                        "type": "object",
                        "additionalProperties": false,
                        "minProperties": 1,
                        "properties": {
                          "rpm": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000000000
                          },
                          "tpm": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000000000
                          },
                          "concurrency": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000000000
                          },
                          "bytesPerSecond": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000000000
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "optionalRequires": [
    "ai.output-pace@1",
    "ai.request-limits@1",
    "ai.output-pace@2"
  ]
}
