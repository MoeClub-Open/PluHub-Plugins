{
  "schemaVersion": 1,
  "id": "official.ai-router",
  "category": "routing",
  "name": "渠道管理",
  "description": "管理渠道、模型映射和可视化功能组合。",
  "codeReload": "restart",
  "version": "0.1.0-alpha.51",
  "host": ">=0.1.0-alpha.17 <0.2.0-0",
  "runtime": {
    "kind": "native",
    "entry": "dist/index.js"
  },
  "provides": [
    "ai.routing@2",
    "ai.execution@1",
    "ai.catalog@2",
    "ai.channels@1",
    "ai.targets@1",
    "ai.groups@1",
    "ai.upstream.systemone@1",
    "ai.upstream.luna@1",
    "ai.upstream.jev@1",
    "ai.workflow-decision@1",
    "ai.workflow-execution@1"
  ],
  "requires": [],
  "permissions": ["api.register", "http.route", "http.dispatch", "http.dispatch.child", "secrets.read", "hooks.register"],
  "configReload": "snapshot",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "nextChannelId": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      },
      "upstreams": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "enum": [
                "openai-chat",
                "openai-responses",
                "anthropic",
                "gemini",
                "systemone",
                "luna",
                "jev",
                "codex",
                "claude-subscription",
                "antigravity",
                "auto-router",
                "grok"
              ]
            },
            "baseUrl": {
              "type": "string",
              "pattern": "^https?://"
            },
            "keyRef": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^(?:env:[A-Z][A-Z0-9_]*|secret:[A-Za-z0-9][A-Za-z0-9_.-]*)$"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^(?:env:[A-Z][A-Z0-9_]*|secret:[A-Za-z0-9][A-Za-z0-9_.-]*)$"
                  }
                }
              ]
            },
            "name": {
              "maxLength": 128,
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "accountId": {
              "type": "string",
              "maxLength": 512
            },
            "projectId": {
              "type": "string",
              "maxLength": 512
            },
            "authMode": {
              "enum": ["siwc", "cli"]
            },
            "flow": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entry", "nodes"],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 128
                },
                "entry": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "layout": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["x", "y"],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      },
                      "y": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      }
                    }
                  }
                },
                "nodes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "type": { "const": "text" },
                          "text": { "type": "string" }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "type": { "const": "format" },
                          "value": {}
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "values"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "type": { "const": "template" },
                          "template": { "type": "string" },
                          "values": {
                            "type": "object",
                            "propertyNames": {
                              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
                              "not": { "enum": ["__proto__", "prototype", "constructor"] }
                            },
                            "additionalProperties": { "type": "string" }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "type": { "const": "replace" },
                          "text": { "type": "string" },
                          "find": { "type": "string" },
                          "replacement": { "type": "string" },
                          "all": { "type": "boolean" }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "promptMode"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "type": { "const": "llm" },
                          "model": { "type": "string" },
                          "channelId": { "type": "string" },
                          "allowedModels": { "type": "array", "items": { "type": "string" } },
                          "protocol": { "enum": ["openai-chat", "openai-responses", "anthropic"] },
                          "messages": { "type": "array", "items": { "type": "object" } },
                          "prompt": { "type": "string" },
                          "system": { "type": "string" },
                          "maxTokens": { "type": "integer" },
                          "promptMode": { "enum": ["append", "replace"] }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "type": { "const": "jev" },
                          "model": { "type": "string" },
                          "channelId": { "type": "string" },
                          "state": {},
                          "questions": { "type": "object" },
                          "assets": { "type": "object" },
                          "answerKey": { "type": "string" }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "type": { "const": "response" },
                          "text": { "type": "string" }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "valueType"],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "type": {
                            "const": "value"
                          },
                          "valueType": {
                            "enum": [
                              "string",
                              "number",
                              "integer",
                              "boolean",
                              "string[]",
                              "object",
                              "json",
                              "secret"
                            ]
                          },
                          "value": {},
                          "secretRef": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^secret:[A-Za-z0-9][A-Za-z0-9_.-]*$"
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "pattern": "^secret:[A-Za-z0-9][A-Za-z0-9_.-]*$"
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "next"],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "type": {
                            "const": "start"
                          },
                          "next": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "condition", "yes", "no"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "type": { "const": "branch" },
                          "condition": { "type": "boolean" },
                          "yes": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "no": { "type": "string", "minLength": 1, "maxLength": 128 }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "test"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "type": { "const": "predicate" },
                          "test": { "type": "string" },
                          "value": { "type": "integer" },
                          "models": { "type": "array", "items": { "type": "string" } },
                          "modelSource": { "type": "string" },
                          "protocol": { "type": "string" }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "valueType", "operator", "left", "right"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "type": { "const": "compare" },
                          "valueType": { "enum": ["string", "number", "boolean"] },
                          "operator": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "matches"] },
                          "left": {},
                          "right": {}
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "operator", "left"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "type": { "const": "logic" },
                          "operator": { "enum": ["and", "or", "not"] },
                          "left": { "type": "boolean" },
                          "right": { "type": "boolean" }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "next"],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "type": {
                            "const": "prompt"
                          },
                          "next": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "text": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "next"],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "type": {
                            "const": "reasoning"
                          },
                          "next": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "effort": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "next"],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "type": {
                            "const": "maxTokens"
                          },
                          "next": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "limit": {
                            "type": "integer"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "next"],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "type": {
                            "const": "tps"
                          },
                          "next": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "rate": {
                            "type": "number"
                          },
                          "tokenizer": {
                            "type": "string"
                          },
                          "aggregateRate": {
                            "type": "number"
                          },
                          "model": {
                            "type": "string"
                          },
                          "inheritDefault": {
                            "type": "boolean"
                          }
                        },
                        "anyOf": [
                          {
                            "required": ["rate"]
                          },
                          {
                            "required": ["aggregateRate"]
                          }
                        ]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type"],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "type": {
                            "const": "upstream"
                          },
                          "target": {
                            "type": "string"
                          },
                          "allowedTargets": {
                            "type": "array",
                            "items": { "type": "string" }
                          },
                          "mode": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type"],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "type": {
                            "const": "provider"
                          },
                          "recordResponseModel": {
                            "type": "boolean"
                          },
                          "upstream": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "protocol": {
                                "type": "string"
                              },
                              "baseUrl": {
                                "type": "string"
                              },
                              "keyRef": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "pattern": "^(?:$|env:[A-Z][A-Z0-9_]*|secret:[A-Za-z0-9][A-Za-z0-9_.-]*)$"
                                  },
                                  {
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "pattern": "^(?:env:[A-Z][A-Z0-9_]*|secret:[A-Za-z0-9][A-Za-z0-9_.-]*)$"
                                    }
                                  }
                                ]
                              },
                              "accountId": {
                                "type": "string"
                              },
                              "projectId": {
                                "type": "string"
                              },
                              "authMode": {
                                "type": "string"
                              },
                              "subscriptionAccountIds": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "interfaces": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "path": {
                                      "type": "string"
                                    },
                                    "streamPath": {
                                      "type": "string"
                                    },
                                    "modelsPath": {
                                      "type": "string"
                                    },
                                    "headers": {
                                      "type": "object",
                                      "additionalProperties": {
                                        "type": "string"
                                      }
                                    },
                                    "params": {
                                      "type": "object"
                                    },
                                    "auth": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "type": {
                                          "type": "string"
                                        },
                                        "name": {
                                          "type": "string"
                                        }
                                      }
                                    },
                                    "incoming": {
                                      "type": "array",
                                      "items": {
                                        "type": "string"
                                      }
                                    },
                                    "protocol": {
                                      "type": "string"
                                    },
                                    "models": {
                                      "type": "array",
                                      "items": {
                                        "type": "string"
                                      }
                                    },
                                    "mediaPaths": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "embeddings": {
                                          "type": "string"
                                        },
                                        "images/generations": {
                                          "type": "string"
                                        },
                                        "images/edits": {
                                          "type": "string"
                                        },
                                        "audio/speech": {
                                          "type": "string"
                                        },
                                        "audio/transcriptions": {
                                          "type": "string"
                                        },
                                        "audio/translations": {
                                          "type": "string"
                                        },
                                        "videos/generations": {
                                          "type": "string"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "model": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type"],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "type": {
                            "const": "routing"
                          },
                          "profile": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "next"],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "type": {
                            "const": "protocol"
                          },
                          "next": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "allow": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "conversion": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "type", "next"],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "type": {
                            "const": "rateLimit"
                          },
                          "next": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "rule": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "rpm": {
                                "type": "integer"
                              },
                              "tpm": {
                                "type": "integer"
                              },
                              "concurrency": {
                                "type": "integer"
                              },
                              "bytesPerSecond": {
                                "type": "integer"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                "bindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["source", "output", "target", "input"],
                    "properties": {
                      "source": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "output": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "input": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    }
                  }
                }
              }
            },
            "consumptionMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "subscriptionAccountIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "interfaces": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["incoming", "protocol"],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/(?!/)"
                  },
                  "streamPath": {
                    "type": "string",
                    "pattern": "^/(?!/)"
                  },
                  "modelsPath": {
                    "type": "string",
                    "pattern": "^/(?!/)"
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "params": {
                    "type": "object"
                  },
                  "auth": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type"],
                    "properties": {
                      "type": {
                        "enum": ["default", "none", "bearer", "header", "query"]
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  },
                  "incoming": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "openai-chat",
                        "openai-responses",
                        "anthropic",
                        "gemini"
                      ]
                    }
                  },
                  "protocol": {
                    "enum": [
                      "openai-chat",
                      "openai-responses",
                      "anthropic",
                      "gemini"
                    ]
                  },
                  "models": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "mediaPaths": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "embeddings": {
                        "type": "string",
                        "pattern": "^/(?!/)"
                      },
                      "images/generations": {
                        "type": "string",
                        "pattern": "^/(?!/)"
                      },
                      "images/edits": {
                        "type": "string",
                        "pattern": "^/(?!/)"
                      },
                      "audio/speech": {
                        "type": "string",
                        "pattern": "^/(?!/)"
                      },
                      "audio/transcriptions": {
                        "type": "string",
                        "pattern": "^/(?!/)"
                      },
                      "audio/translations": {
                        "type": "string",
                        "pattern": "^/(?!/)"
                      },
                      "videos/generations": {
                        "type": "string",
                        "pattern": "^/(?!/)"
                      }
                    }
                  }
                }
              }
            },
            "priority": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "protocol": {
                    "enum": [
                      "openai-chat",
                      "openai-responses",
                      "anthropic",
                      "gemini",
                      "codex",
                      "claude-subscription",
                      "antigravity",
                      "grok",
                      "systemone",
                      "luna",
                      "jev"
                    ]
                  }
                },
                "required": ["protocol"]
              },
              "then": {
                "anyOf": [
                  {
                    "required": ["baseUrl", "keyRef"]
                  },
                  {
                    "required": ["baseUrl"],
                    "properties": { "protocol": { "enum": ["systemone", "luna", "jev"] } }
                  },
                  {
                    "required": ["subscriptionAccountIds"]
                  }
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": ["baseUrl"]
                    },
                    {
                      "required": ["keyRef"]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "not": {
                  "required": ["protocol"]
                }
              },
              "then": {
                "required": ["flow"]
              }
            }
          ]
        }
      },
      "models": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["upstream", "model"],
          "properties": {
            "upstream": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "maxLength": 1024,
              "type": "string"
            },
            "provider": {
              "maxLength": 1024,
              "type": "string"
            },
            "description": {
              "maxLength": 1024,
              "type": "string"
            },
            "contextWindow": {
              "minimum": 1,
              "maximum": 100000000,
              "type": "integer"
            },
            "inputPrice": {
              "minimum": 0,
              "maximum": 1000000,
              "type": "number"
            },
            "outputPrice": {
              "minimum": 0,
              "maximum": 1000000,
              "type": "number"
            },
            "reasoningEfforts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              }
            },
            "pricing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": ["tokens", "request", "expression"]
                },
                "request": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "cacheRead": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "cacheWrite": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "cacheWrite1h": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "tiers": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["above", "input", "output"],
                    "properties": {
                      "above": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100000000
                      },
                      "input": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "output": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "cacheRead": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "cacheWrite": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "cacheWrite1h": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000
                      }
                    }
                  }
                },
                "expression": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "webSearch": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000
                }
              }
            },
            "operations": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "chat",
                  "embeddings",
                  "images/generations",
                  "images/edits",
                  "videos/generations",
                  "audio/speech",
                  "audio/transcriptions",
                  "audio/translations"
                ]
              }
            },
            "publicModel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      },
      "redirects": {
        "type": "object",
        "maxProperties": 1024,
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "mode"],
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "mode": {
              "enum": ["implicit", "explicit"]
            },
            "enabled": {
              "type": "boolean"
            }
          }
        }
      },
      "groups": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "enabled": {
              "type": "boolean"
            },
            "channelIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "multiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "userIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "secretRefs": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^(?:env:[A-Z][A-Z0-9_]*|secret:[A-Za-z0-9][A-Za-z0-9_.-]*)$"
        }
      }
    }
  },
  "ui": {
    "entry": "dist/ui.js",
    "title": "渠道",
    "path": "/channels",
    "public": false,
