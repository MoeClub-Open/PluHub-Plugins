{
  "schemaVersion": 1,
  "id": "official.tickets",
  "category": "operations",
  "name": "工单与支持",
  "description": "提供用户工单、客服回复与处理状态管理。",
  "version": "0.1.0-alpha.12",
  "host": ">=0.1.0-alpha.1 <0.2.0-0",
  "codeReload": "restart",
  "runtime": {
    "kind": "native",
    "entry": "dist/index.js"
  },
  "provides": [],
  "requires": ["users.lookup@1"],
  "optionalRequires": [],
  "permissions": ["api.register"],
  "configReload": "snapshot",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxOpenPerUser": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "dailyCreateLimit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      },
      "hourlyMessageLimit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      }
    }
  },
  "ui": {
    "title": "我的工单",
    "entry": "dist/ui.js",
    "path": "/tickets",
    "public": true,
    "pages": [
      {
        "title": "工单管理",
        "path": "/settings/tickets",
        "group": "system",
        "order": 40,
        "public": false
      }
    ]
  }
}
