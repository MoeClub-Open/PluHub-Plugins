{
  "schemaVersion": 1,
  "id": "official.byok",
  "category": "routing",
  "name": "个人渠道",
  "description": "管理用户自带密钥、个人渠道及消耗倍率。",
  "codeReload": "restart",
  "version": "0.1.0-alpha.14",
  "host": ">=0.1.0-alpha.1 <0.2.0-0",
  "runtime": {
    "kind": "native",
    "entry": "dist/index.js"
  },
  "provides": [
    "credentials.select@1",
    "credentials.resolve@1",
    "ai.user-channels@1"
  ],
  "requires": [
    "http.transport@1"
  ],
  "optionalRequires": [
    "ai.routing@1",
    "ai.execution@1",
    "ai.upstream.openai-chat@1",
    "ai.upstream.openai-responses@1",
    "ai.upstream.anthropic@1",
    "ai.upstream.gemini@1",
    "ai.upstream.codex@1",
    "ai.upstream.claude-subscription@1",
    "ai.upstream.antigravity@1",
    "auth.admin@1",
    "ai.subscription.codex@1",
    "ai.subscription.claude-subscription@1",
    "ai.subscription.antigravity@1",
    "ai.request-limits@1",
    "ai.output-pace@1",
    "ai.output-pace@2"
  ],
  "permissions": [
    "api.register",
    "secrets.read"
  ],
  "configReload": "restart",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "masterKeyRef": {
        "type": "string",
        "pattern": "^env:[A-Z][A-Z0-9_]*$"
      },
      "secretRefs": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^env:[A-Z][A-Z0-9_]*$"
        },
        "uniqueItems": true
      },
      "allowedPrivateOrigins": {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2048
        }
      }
    }
  },
  "ui": {
    "title": "个人渠道",
    "entry": "dist/ui.js",
    "path": "/byok",
    "public": true,
    "pages": [
      {
        "title": "用户渠道管理",
        "path": "/settings/user-channels",
        "public": false,
        "group": "routing",
        "order": 30
      }
    ]
  }
}
